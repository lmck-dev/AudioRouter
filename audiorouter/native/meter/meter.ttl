@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:audiorouter:meter>
	a lv2:Plugin , lv2:AnalyserPlugin ;
	doap:name "Audio Router level tap" ;
	lv2:optionalFeature lv2:hardRTCapable ;
	lv2:port [
		a lv2:InputPort , lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "In L"
	] , [
		a lv2:InputPort , lv2:AudioPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "In R"
	] , [
		a lv2:InputPort , lv2:ControlPort ; lv2:index 2 ; lv2:symbol "slot" ; lv2:name "Slot" ;
		lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 255 ; lv2:portProperty lv2:integer
	] .
