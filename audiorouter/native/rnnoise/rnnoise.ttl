@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix pprop: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<urn:audiorouter:rnnoise>
	a lv2:Plugin , lv2:FilterPlugin ;
	doap:name "Voice noise suppression" ;
	rdfs:comment "Removes background noise from speech (RNNoise). Built by Audio Router." ;
	lv2:optionalFeature lv2:hardRTCapable ;
	lv2:port [
		a lv2:InputPort , lv2:AudioPort ;
		lv2:index 0 ;
		lv2:symbol "in" ;
		lv2:name "In"
	] , [
		a lv2:OutputPort , lv2:AudioPort ;
		lv2:index 1 ;
		lv2:symbol "out" ;
		lv2:name "Out"
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 2 ;
		lv2:symbol "threshold" ;
		lv2:name "Voice gate" ;
		rdfs:comment "Mute when RNNoise is less sure than this that someone is talking. 0 never mutes." ;
		lv2:default 0.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 95.0 ;
		units:unit units:pc
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 3 ;
		lv2:symbol "hold" ;
		lv2:name "Gate hold" ;
		rdfs:comment "How long the gate stays open after speech stops." ;
		lv2:default 200.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1000.0 ;
		units:unit units:ms
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 4 ;
		lv2:symbol "mix" ;
		lv2:name "Amount" ;
		rdfs:comment "How much of the cleaned sound to use; the rest is the original." ;
		lv2:default 100.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 100.0 ;
		units:unit units:pc
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 5 ;
		lv2:symbol "enabled" ;
		lv2:name "Enabled" ;
		lv2:designation lv2:enabled ;
		lv2:default 1.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0 ;
		lv2:portProperty lv2:toggled , lv2:connectionOptional , pprop:notOnGUI
	] , [
		a lv2:OutputPort , lv2:ControlPort ;
		lv2:index 6 ;
		lv2:symbol "latency" ;
		lv2:name "Latency" ;
		lv2:designation lv2:latency ;
		lv2:portProperty lv2:reportsLatency , lv2:integer , lv2:connectionOptional , pprop:notOnGUI ;
		units:unit units:frame
	] .
